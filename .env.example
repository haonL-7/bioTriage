# ============================================
# Environment Variable Template
# ⚠️  Copy this to .env and fill in your keys.
# ⚠️  NEVER commit .env to git!
# ============================================

# ---------- 第三方模型（付费，必填） ----------
# DeepSeek API Key (required for AI analysis)
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# Optional: GLM API Key (fallback when DeepSeek is unavailable)
GLM_API_KEY=your-glm-key-here

# ---------- ORCID 登录（免费，注册方法见 docs/ORCID账号系统.md） ----------
# Client ID / Client Secret：在 https://orcid.org/developer-tools 创建应用后获得
# （沙箱环境用 https://sandbox.orcid.org/developer-tools 注册，两者 id/secret 不通用）
# ⚠️ 真实值走 Dashboard / 本地 .env，不要提交
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=your-orcid-client-secret

# ORCID 基础地址：生产 https://orcid.org，联调/自动化测试 https://sandbox.orcid.org
# 不设置时应用按缺省 https://sandbox.orcid.org 处理
ORCID_BASE_URL=https://sandbox.orcid.org

# ---------- 站点地址与会话 ----------
# 站点对外地址，用于拼 redirect_uri；必须是 ORCID 后台登记的回调前缀
# 本地开发：http://127.0.0.1:8000 ；生产：https://<你的域名>
# ORCID 后台登记的 Redirect URI 必须精确等于 $APP_BASE_URL + /api/auth/callback
APP_BASE_URL=http://127.0.0.1:8000

# 会话 cookie（bt_session）的 HMAC-SHA256 密钥，至少 32 字节随机值
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 缺失时应用仍可启动，但登录端点会返回明确错误
SESSION_SECRET=

# 会话有效期（秒），默认 30 天
SESSION_MAX_AGE=2592000

# ---------- 持久化 ----------
# 缺省 sqlite:///./biotriage.db ；生产建议托管 Postgres：
# DATABASE_URL=postgresql://user:password@host:5432/biotriage
# ⚠️ 只有这里的值是 postgres 时才需要安装 psycopg2-binary（惰性依赖）
DATABASE_URL=sqlite:///./biotriage.db

# ---------- 每日配额（对 /api/ai_analyze 生效） ----------
# 匿名用户：每 IP 每天次数（默认 1）
AI_DAILY_QUOTA_ANON=1
# ORCID 登录用户：每人每天次数（默认 5）
AI_DAILY_QUOTA_PER_USER=5

# Railway / Render 会自动设置 PORT，本地可留默认
PORT=8000
